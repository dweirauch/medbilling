# Copy this file to .env for local testing.
# On Render, these get set in the dashboard instead. Never commit a real .env file.

# Provided by Render when you create a Postgres database and link it to this
# web service. For local testing, point to a local Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/claimscrub

# Stripe dashboard > Developers > API keys. Use the TEST/sandbox secret key
# (starts with sk_test_) until you're ready to take real payments.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Webhook signing secret (starts with whsec_). From the Stripe CLI for local
# testing, or from your webhook endpoint's settings once deployed.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Optional. By default, customers are sent back to whatever web address they
# used. Set this only to force a specific one.
# FRONTEND_URL=https://medclaimscrub.com

# Optional. Only if the website pages are not in ../website
# WEBSITE_DIR=/path/to/website

PORT=3000
